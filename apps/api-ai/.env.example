# Phase 0 — only health check is wired. Everything below is read for forward-compat.

# Redis (Arq queue)
REDIS_URL=redis://localhost:6379/0

# Supabase
SUPABASE_URL=http://localhost:54321
SUPABASE_SERVICE_ROLE_KEY=replace-me

# OpenRouter (Phase 2+)
OPENROUTER_API_KEY=replace-me
OPENROUTER_MODEL_PRIMARY=deepseek/deepseek-v4-pro
OPENROUTER_MODEL_BULK=deepseek/deepseek-v4-flash
OPENROUTER_MODEL_FALLBACK=anthropic/claude-3.5-sonnet

# Limits (Phase 2+)
MAX_PDFS_PER_JOB=50
MAX_PDF_BYTES=26214400          # 25 MiB
MAX_OCR_PAGES_PER_DAY=2000
MAX_LLM_TOKENS_PER_MONTH=2000000
