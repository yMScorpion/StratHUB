# Phase 2 — ingestion pipeline active.

# Redis (Arq queue)
REDIS_URL=redis://localhost:6379/0

# Shared token required by internal job APIs
INTERNAL_API_KEY=replace-me

# Supabase
SUPABASE_URL=http://localhost:54321
SUPABASE_SERVICE_ROLE_KEY=replace-me

# OpenRouter — primary LLM for strategy compilation
OPENROUTER_API_KEY=replace-me
OPENROUTER_MODEL_PRIMARY=deepseek/deepseek-v4-pro
OPENROUTER_MODEL_BULK=deepseek/deepseek-v4-flash
OPENROUTER_MODEL_FALLBACK=anthropic/claude-3.5-sonnet

# OpenAI — used for text embeddings
OPENAI_API_KEY=replace-me
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# BYOK: false = platform pays; true = user supplies their own API keys
BYOK_MODE=false

# Per-job limits
MAX_PDFS_PER_JOB=50
MAX_PDF_BYTES=26214400          # 25 MiB
MAX_PAGES_PER_PDF=500

# Daily / monthly rate limits
MAX_JOBS_PER_DAY=10
MAX_OCR_PAGES_PER_DAY=2000
MAX_LLM_TOKENS_PER_MONTH=2000000

# Concurrency (Phase 5+)
MAX_CONCURRENT_VALIDATORS=5
