{
  "name": "crypto-trading-system",
  "private": true,
  "version": "0.0.0",
  "description": "AI-driven crypto trading: PDF -> Strategy Spec -> backtest -> 7d paper validation -> live execution.",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.11.0",
    "pnpm": ">=9.15.0"
  },
  "scripts": {
    "build": "turbo run build",
