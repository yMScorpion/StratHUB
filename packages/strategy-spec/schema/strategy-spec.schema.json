{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crypto-trading-system.local/schemas/strategy-spec/1.0.0.json",
  "title": "StrategySpec",
  "description": "Canonical, executable strategy specification. Source of truth for backtest, paper, and live execution.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec_version",
    "asset_class",
    "exchange",
    "symbols",
    "timeframe",
    "indicators",
    "patterns",
    "filters",
    "entries",
    "exits",
    "risk",
    "citations"
  ],
  "properties": {
    "spec_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$",
      "description": "Semver-like spec version. Major bump means breaking interpreter change."
    },
    "spec_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Optional. When set, must equal sha256 of the canonical JSON of this object with spec_hash omitted."
    },
    "asset_class": { "enum": ["spot", "perp"] },
    "exchange": { "enum": ["binance", "bybit"] },
    "symbols": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "type": "string", "pattern": "^[A-Z0-9]{2,20}$" },
      "uniqueItems": true
    },
    "timeframe": {
      "enum": ["1m", "3m", "5m", "15m", "30m", "1h", "2h", "4h", "6h", "8h", "12h", "1d"]
    },
    "indicators": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/indicator" }
    },
    "patterns": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/pattern" }
    },
    "filters": {
      "type": "array",
      "maxItems": 16,
      "items": { "$ref": "#/$defs/filter" }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/entry" }
    },
    "exits": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": { "$ref": "#/$defs/exit" }
    },
    "risk": { "$ref": "#/$defs/risk" },
    "citations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/citation" },
      "description": "Every spec MUST include at least one citation back to the source PDF page."
    },
    "metadata": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,31}$"
    },
    "rule_ref": {
      "type": "string",
      "pattern": "^(risk(\\.[a-z_]+)?|(entries|exits|filters|patterns|indicators)\\[[0-9]+\\](\\.[a-z_]+)?)$"
    },
    "indicator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "params"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": {
          "enum": ["sma", "ema", "rsi", "atr", "macd", "bb", "vwap", "volume_ma", "obv", "adx"]
        },
        "params": {
          "type": "object",
          "additionalProperties": { "type": "number" }
        },
        "source": { "enum": ["close", "open", "high", "low", "hlc3", "ohlc4", "volume"] }
      }
    },
    "pattern": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "params"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": {
          "enum": [
            "wyckoff_spring",
            "wyckoff_upthrust",
            "wyckoff_phase_a",
            "wyckoff_phase_b",
            "wyckoff_phase_c",
            "wyckoff_phase_d",
            "wyckoff_phase_e",
            "vsa_no_supply",
            "vsa_no_demand",
            "vsa_stopping_volume",
            "vsa_climactic_volume",
            "vsa_effort_no_result",
            "vsa_test_bar",
            "order_block",
            "fair_value_gap",
            "liquidity_sweep",
            "break_of_structure",
            "change_of_character"
          ]
        },
        "params": {
          "type": "object",
          "additionalProperties": { "type": ["number", "string", "boolean"] }
        }
      }
    },
    "filter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "params"],
      "properties": {
        "kind": {
          "enum": ["session", "regime", "volatility", "min_price", "max_spread_bps", "weekday"]
        },
        "params": {
          "type": "object",
          "additionalProperties": { "type": ["number", "string", "boolean"] }
        }
      }
    },
    "size": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": { "enum": ["risk_pct", "fixed_pct", "fixed_notional", "kelly_fraction", "vol_target"] },
        "value": {
          "type": "string",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
          "description": "Decimal string (never float). Range and unit are kind-dependent."
        },
        "kelly_cap": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?$",
          "description": "Optional cap on Kelly fraction (e.g. \"0.25\" = quarter-Kelly)."
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["side", "when", "size"],
      "properties": {
        "side": { "enum": ["long", "short"] },
        "when": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "description": "Boolean expression over indicator/pattern/filter ids: e.g. 'wy_spring && vsa_no_supply'. Allowed ops: && || ! ( ) and bareword ids. No function calls, no arithmetic, no implicit truthiness."
        },
        "size": { "$ref": "#/$defs/size" },
        "max_concurrent_per_symbol": { "type": "integer", "minimum": 1, "maximum": 10 }
      }
    },
    "exit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "params"],
      "properties": {
        "kind": {
          "enum": [
            "stop_atr",
            "stop_pct",
            "stop_swing",
            "tp_rr",
            "tp_pct",
            "tp_atr",
            "trailing",
            "time_stop",
            "indicator_cross"
          ]
        },
        "params": {
          "type": "object",
          "additionalProperties": { "type": ["number", "string", "boolean"] }
        }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "per_trade_pct", "max_concurrent"],
      "properties": {
        "model": {
          "enum": ["fixed_pct", "fixed_notional", "kelly_fraction", "vol_target"]
        },
        "per_trade_pct": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?$",
          "description": "Risk per trade as a percent string (e.g. \"0.5\" = 0.5%). Decimal string, never float."
        },
        "max_concurrent": { "type": "integer", "minimum": 1, "maximum": 32 },
        "max_daily_loss_pct": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?$"
        },
        "min_rr": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?$",
          "description": "Minimum acceptable reward:risk ratio. Apostila methodology requires >= 3."
        }
      }
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_ref", "pdf_id", "pages"],
      "properties": {
        "rule_ref": { "$ref": "#/$defs/rule_ref" },
        "pdf_id": { "type": "string", "format": "uuid" },
        "pages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "type": "integer", "minimum": 1 },
          "uniqueItems": true
        },
        "quote": { "type": "string", "maxLength": 1024 }
      }
    }
  }
}
